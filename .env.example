# =============================================================================
# LabitConf Giveaway - Environment Variables
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE (Required)
# -----------------------------------------------------------------------------
# Postgres connection string for Drizzle ORM
# Local: Use Supabase local instance (see supabase:status for connection string)
# Production: Use Supabase project connection string (pooler recommended)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Alternative to DATABASE_URL (used as fallback)
# POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# -----------------------------------------------------------------------------
# SUPABASE (Required)
# -----------------------------------------------------------------------------
# Supabase project URL
# Local: http://127.0.0.1:54321
# Production: https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase Anonymous Key (public, safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (secret, server-side only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -----------------------------------------------------------------------------
# APPLICATION (Optional)
# -----------------------------------------------------------------------------
# Base URL for metadata and social sharing
# Production: Netlify auto-provides URL env var, but this can override it
# Local: Defaults to localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Comma-separated list of allowed CORS origins
# Leave empty in development to allow localhost
ALLOWED_ORIGINS=https://labitconf.mezo.org,https://mezo.org
