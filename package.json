{
  "name": "labitconf-giveaway",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "test": "bun test --preload ./test-setup.ts",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "fix-imports": "node fix-imports.mjs",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset",
    "supabase:studio": "open http://127.0.0.1:54323",
    "supabase:migration": "supabase migration new",
    "supabase:types": "supabase gen types typescript --local > src/lib/db/types.ts",
    "db:pull": "dotenv -e .env.local -- bunx drizzle-kit pull",
    "db:migrate:local": "supabase migration up && bun run db:pull",
    "db:migrate": "supabase db push"
  },
  "dependencies": {
    "@formatjs/intl-localematcher": "^0.6.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@supabase/supabase-js": "^2.75.0",
    "@vercel/speed-insights": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.6",
    "ethers": "^6.15.0",
    "lucide-react": "^0.544.0",
    "multicoin-address-validator": "^0.5.26",
    "negotiator": "^1.0.0",
    "next": "15.5.4",
    "postgres": "^3.4.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@netlify/plugin-nextjs": "^5.14.5",
    "@tailwindcss/postcss": "^4",
    "@types/multicoin-address-validator": "^0.5.3",
    "@types/negotiator": "^0.6.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "bun-types": "^1.3.0",
    "dotenv-cli": "^10.0.0",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-import-helpers": "^2.0.1",
    "eslint-plugin-import-newlines": "^1.4.0",
    "eslint-plugin-no-restricted-imports": "^0.0.0",
    "glob": "^11.0.3",
    "prettier": "^3.6.2",
    "shadcn": "^3.3.1",
    "supabase": "^2.51.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vercel": "^48.4.1"
  }
}
